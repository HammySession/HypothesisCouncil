# Rubber Duck providers are configured through inherited environment variables.
CLI_CLAUDE_ENABLED=true
CLI_CODEX_ENABLED=true
CLI_GEMINI_ENABLED=true
CLI_GROK_ENABLED=true

# HTTP providers are also supported.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Optional Hypothesis Council session location.
# HYPOTHESIS_COUNCIL_HOME=/absolute/path/to/sessions

# Optional exact context-window overrides for providers that do not report a concrete model.
# Names are uppercased and punctuation becomes underscores.
# HYPOTHESIS_COUNCIL_CONTEXT_TOKENS_CLI_CODEX=1050000
# HYPOTHESIS_COUNCIL_CONTEXT_TOKENS_CLI_CLAUDE=200000

# Optional Codex reasoning effort for the stdin compatibility adapter.
# HYPOTHESIS_COUNCIL_CODEX_REASONING_EFFORT=xhigh

# Optional provider subprocess timeout in milliseconds. MCP requests add one minute of headroom.
# HYPOTHESIS_COUNCIL_PROVIDER_TIMEOUT_MS=900000

# Preserve Rubber Duck's original argument-based Codex/Claude presets if required.
# HYPOTHESIS_COUNCIL_DISABLE_STDIN_COMPATIBILITY=true
