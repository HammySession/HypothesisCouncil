{
  "name": "hypothesis-council",
  "version": "0.1.0",
  "description": "A council of AI coding agents that generate, review, and attack hypotheses about your code",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "hypothesis-council-mcp": "./dist/index.js",
    "hypothesis-council": "./dist/cli/hypothesis-council.js",
    "hc": "./dist/cli/hypothesis-council.js"
  },
  "files": [
    "dist",
    "docs/*.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "npm run build",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "cli": "node dist/cli/hypothesis-council.js",
    "doctor": "node dist/cli/hypothesis-council.js doctor",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test -- --runInBand && npm run build"
  },
  "keywords": [
    "hypothesis",
    "research",
    "council",
    "cli",
    "mcp",
    "model-context-protocol",
    "llm",
    "claude",
    "codex",
    "gemini",
    "grok",
    "rubber-duck"
  ],
  "author": "Hypothesis Council contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HammySession/HypothesisCouncil.git"
  },
  "homepage": "https://github.com/HammySession/HypothesisCouncil#readme",
  "bugs": {
    "url": "https://github.com/HammySession/HypothesisCouncil/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "mcp-rubber-duck": "1.20.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
