{
  "name": "hypothesis-council",
  "version": "0.1.0",
  "description": "An inspectable hypothesis-generation council built on MCP Rubber Duck",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "hypothesis-council-mcp": "./dist/index.js",
    "hypothesis-council": "./dist/cli/hypothesis-council.js",
    "hc": "./dist/cli/hypothesis-council.js"
  },
  "files": [
    "dist",
    "docs",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "cli": "node dist/cli/hypothesis-council.js",
    "stock:markdown": "./scripts/run-stock-embeddings-markdown.sh",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "openai",
    "ai",
    "rubber-duck"
  ],
  "mcpName": "io.github.hammysession/hypothesis-council",
  "author": "Hypothesis Council contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HammySession/HypothesisCouncil.git"
  },
  "homepage": "https://github.com/HammySession/HypothesisCouncil#readme",
  "bugs": {
    "url": "https://github.com/HammySession/HypothesisCouncil/issues"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "mcp-rubber-duck": "1.20.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
